      "results": [
        {
          "properties": {
            "tags": [
              "DATADOG_CONFIDENCE:HIGH",
              "DATADOG_CONFIDENCE_REASON:Source: The 'username' parameter injected via @CurrentUsername. Sink: The PrintWriter initialization at line 34 which performs filesystem interaction. Dataflow: The untrusted 'username' is concatenated directly into the file path string without any validation or sanitization. This allows an attacker to manipulate the path via sequences like ../ to write files outside the intended directory. No sanitization is performed on the username before it is used to construct the file path. Conclusion: This is a confirmed path traversal vulnerability."
            ]
          },
          "ruleId": "datadog/java-xss",
          "ruleIndex": 7,
          "level": "warning",
          "message": {
            "text": "Source: The 'username' parameter injected via @CurrentUsername. Sink: The PrintWriter initialization at line 34 which performs filesystem interaction. Dataflow: The untrusted 'username' is concatenated directly into the file path string without any validation or sanitization. This allows an attacker to manipulate the path via sequences like ../ to write files outside the intended directory. No sanitization is performed on the username before it is used to construct the file path. Conclusion: This is a confirmed path traversal vulnerability."
          },
          "locations": [
            {
