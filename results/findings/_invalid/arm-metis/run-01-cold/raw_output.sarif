                                    "snippet": {
                                        "text": "21:   private final String[] solutions = {\"Solution 1\", \"Solution 2\"};\n 22:   private final boolean[] guesses = new boolean[solutions.length];\n\n 24:   @PostMapping(\"/JWT/quiz\")\n 25:   @ResponseBody\n 26:   public AttackResult completed(\n 27:       @RequestParam String[] question_0_solution, @RequestParam String[] question_1_solution) {\n 28:     int correctAnswers = 0;\n\n 30:     String[] givenAnswers = {question_0_solution[0], question_1_solution[0]};\n\n 32:     for (int i = 0; i < solutions.length; i++) {\n 33:       if (givenAnswers[i].contains(solutions[i])) {\n 34:         // answer correct\n 35:         correctAnswers++;\n 36:         guesses[i] = true;\n 37:       } else {\n 38:         // answer incorrect\n 39:         guesses[i] = false;\n 40:       }\n 41:     }\n\n 50:   @GetMapping(\"/JWT/quiz\")\n 51:   @ResponseBody\n 52:   public boolean[] getResults() {\n 53:     return this.guesses;\n 54:   }"
