          "properties": {
            "tags": [
              "DATADOG_CONFIDENCE:HIGH",
              "DATADOG_CONFIDENCE_REASON:Source: The 'query' parameter in the completed() method, which is user-controlled via HTTP POST.\n\nSink: Line 65: statement.executeQuery(query).\n\nDataflow: The untrusted input 'query' is passed directly into the executeQuery() method of a JDBC Statement object without any sanitization or parameterization.\n\nConclusion: This is a textbook SQL injection vulnerability intentionally included in the WebGoat training application for demonstration purposes."
            ]
          },
          "ruleId": "datadog/java-sqli",
          "ruleIndex": 5,
          "level": "warning",
          "message": {
            "text": "Source: The 'query' parameter in the completed() method, which is user-controlled via HTTP POST.\n\nSink: Line 65: statement.executeQuery(query).\n\nDataflow: The untrusted input 'query' is passed directly into the executeQuery() method of a JDBC Statement object without any sanitization or parameterization.\n\nConclusion: This is a textbook SQL injection vulnerability intentionally included in the WebGoat training application for demonstration purposes."
          },
          "locations": [
