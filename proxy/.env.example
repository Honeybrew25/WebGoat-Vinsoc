# Sao chép file này thành proxy/.env rồi điền giá trị thật.
# proxy/.env đã bị .gitignore — KHÔNG BAO GIỜ commit API key.

# API key của Google Gemini (lấy ở https://aistudio.google.com/apikey).
# LiteLLM đọc biến này để gọi gemini-3.1-flash-lite.
GEMINI_API_KEY=your-gemini-api-key-here

# Khoá bảo vệ chính proxy. Các tool phải gửi header
# Authorization: Bearer <LITELLM_MASTER_KEY> mới gọi được.
# KHÔNG được để trống: litellm_config.yaml có `master_key: os.environ/...`, nếu rỗng
# thì LiteLLM coi mọi Bearer là "virtual key" và đi tra DB -> lỗi "No connected db".
# Phải bắt đầu bằng "sk-".
LITELLM_MASTER_KEY=sk-sast-bench-local
